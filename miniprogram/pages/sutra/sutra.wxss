.wrap { padding: 24rpx 28rpx; }

.group { margin-bottom: 24rpx; }

.group-cat {
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.sutra-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sutra-item:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.sutra-hover { opacity: 0.8; }

.sutra-title {
  font-size: 40rpx;
  color: var(--ink);
}

.sutra-name {
  font-size: 26rpx;
  color: var(--ink2);
  margin: 4rpx 0;
}
