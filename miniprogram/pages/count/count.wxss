.wrap {
  padding: 24rpx 28rpx;
  text-align: center;
}

.phrase {
  font-size: 44rpx;
  color: var(--gold);
  letter-spacing: 8rpx;
  padding: 16rpx 0 8rpx;
}

.counter-area {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.counter {
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 4rpx solid var(--accent);
  background: var(--card);
  box-shadow: 0 8rpx 40rpx rgba(158, 61, 51, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.counter-press {
  transform: scale(0.97);
  opacity: 0.9;
}

.counter-num {
  font-size: 120rpx;
  color: var(--accent);
  line-height: 1.2;
}

.counter-label {
  color: var(--ink2);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.info { text-align: left; }

.row {
  display: flex;
  text-align: center;
  margin-bottom: 24rpx;
}

.cell { flex: 1; }

.cell-num {
  font-size: 44rpx;
  color: var(--ink);
}

.progress {
  height: 14rpx;
  background: var(--accent-soft);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  background: var(--accent);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.target-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.reset {
  margin-top: 32rpx;
}
