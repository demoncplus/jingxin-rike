.wrap {
  padding: 24rpx 28rpx;
}

.head-card {
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.head-icon {
  font-size: 80rpx;
}

.head-title {
  font-size: 40rpx;
  margin: 8rpx 0;
  color: var(--ink);
}

.cell {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.cell-hover { opacity: 0.85; }

.cell-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
}

.arrow {
  color: var(--ink2);
  font-size: 40rpx;
}
